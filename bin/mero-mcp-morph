#!/usr/bin/env python3
import sys
import os
import signal
import subprocess
import shutil
import re

p = None

def handle_sig(sig, frame):
    global p
    if p and p.poll() is None:
        p.terminate()
        try:
            p.wait(timeout=3)
        except Exception:
            p.kill()
    sys.exit(0)

signal.signal(signal.SIGTERM, handle_sig)
signal.signal(signal.SIGINT, handle_sig)

morph_bin = os.environ.get("MERO_MCP_MORPH_BIN")
if not morph_bin or not os.path.exists(morph_bin):
    candidates = [
        os.path.expanduser("~/.local/share/mero-mcp/morph/node_modules/.bin/morph-mcp"),
        os.path.expanduser("~/.local/bin/morph-mcp"),
        "/usr/local/bin/morph-mcp",
    ]
    for c in candidates:
        if os.path.exists(c):
            morph_bin = c
            break

if not morph_bin:
    morph_bin = shutil.which("morph-mcp")

# Extract MORPH_API_KEY from secrets file if not in environment
if not os.environ.get("MORPH_API_KEY"):
    secret_files = [
        os.path.expanduser("~/.config/mero/codex-secrets.toml"),
        os.path.expanduser("~/.config/mero/secrets.toml"),
    ]
    for s_file in secret_files:
        if os.path.exists(s_file) and os.access(s_file, os.R_OK):
            try:
                with open(s_file, "r") as f:
                    content = f.read()
                # Find MORPH_API_KEY in toml
                m = re.search(r'MORPH_API_KEY\s*=\s*["\']([^"\']+)["\']', content)
                if m:
                    os.environ["MORPH_API_KEY"] = m.group(1)
                    break
            except Exception:
                pass

if morph_bin and os.path.exists(morph_bin):
    cmd = [morph_bin] + sys.argv[1:]
elif shutil.which("npx"):
    cmd = ["npx", "-y", "@morphllm/morphmcp"] + sys.argv[1:]
else:
    sys.stderr.write("Error: Morph MCP runtime not found. Install with npm install @morphllm/morphmcp\n")
    sys.exit(1)

p = subprocess.Popen(cmd)
ret = p.wait()
sys.exit(0 if ret in (0, -15, -2, 143, 130) else ret)
