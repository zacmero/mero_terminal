#!/usr/bin/env bash

set -euo pipefail

self_real="$(readlink -f "$0" 2>/dev/null || printf '%s\n' "$0")"
real_fastfetch=""

for candidate in /usr/bin/fastfetch /usr/local/bin/fastfetch "$HOME/.local/bin/fastfetch"; do
  [[ -x "$candidate" ]] || continue
  candidate_real="$(readlink -f "$candidate" 2>/dev/null || printf '%s\n' "$candidate")"
  if [[ "$candidate_real" != "$self_real" ]]; then
    real_fastfetch="$candidate"
    break
  fi
done

if [[ -z "$real_fastfetch" ]]; then
  while IFS= read -r candidate; do
    [[ -x "$candidate" ]] || continue
    candidate_real="$(readlink -f "$candidate" 2>/dev/null || printf '%s\n' "$candidate")"
    if [[ "$candidate_real" != "$self_real" ]]; then
      real_fastfetch="$candidate"
      break
    fi
  done < <(type -ap fastfetch 2>/dev/null || true)
fi

if [[ -z "$real_fastfetch" ]]; then
  printf 'fastfetch: real binary not found\n' >&2
  exit 1
fi

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch"
[[ -d "$config_dir" ]] || config_dir="$HOME/mero_terminal/fastfetch"

host_name="${HOSTNAME:-$(hostname 2>/dev/null || true)}"
is_mero_machine=false
[[ "$host_name" == "mero-machine" ]] && is_mero_machine=true

run_config() {
  local config_name="$1"
  local logo_size="$2"
  shift 2

  if $is_mero_machine; then
    exec "$real_fastfetch" \
      --config "$config_dir/$config_name" \
      --logo "$logo_size" \
      --logo-type builtin \
      "$@"
  fi

  exec "$real_fastfetch" --config "$config_dir/$config_name" "$@"
}

run_responsive_config() {
  local workstation_config="$1"
  local universal_config="$2"
  shift 2

  if $is_mero_machine; then
    exec "$real_fastfetch" --config "$config_dir/$workstation_config" "$@"
  fi

  exec "$real_fastfetch" --config "$config_dir/$universal_config" "$@"
}

case "${1:-}" in
  complete|full|--full|-f)
    shift
    run_config config.full.jsonc arch "$@"
    ;;
  compact|--compact)
    shift
    run_responsive_config config.compact.jsonc config.compact.universal.jsonc "$@"
    ;;
  tiny|mobile|--tiny|-t)
    shift
    run_responsive_config config.tiny.jsonc config.tiny.universal.jsonc "$@"
    ;;
  -c|--config|-h|--help|-v|--version|--list-*)
    exec "$real_fastfetch" "$@"
    ;;
esac

# Read the PTY directly so stale shell $COLUMNS values cannot select a wide layout.
cols="${MERO_FASTFETCH_COLUMNS:-}"
if [[ -z "$cols" ]] && [[ -t 1 ]] && [[ -r /dev/tty ]]; then
  read -r _ cols < <(stty size < /dev/tty 2>/dev/null || true)
fi
if ! [[ "$cols" =~ ^[1-9][0-9]*$ ]]; then
  cols="$(tput cols 2>/dev/null || true)"
fi
if ! [[ "$cols" =~ ^[1-9][0-9]*$ ]]; then
  cols="${COLUMNS:-80}"
fi
if ! [[ "$cols" =~ ^[1-9][0-9]*$ ]]; then
  cols=80
fi

if (( cols < 62 )); then
  run_responsive_config config.tiny.jsonc config.tiny.universal.jsonc "$@"
elif (( cols < 105 )); then
  run_responsive_config config.compact.jsonc config.compact.universal.jsonc "$@"
elif $is_mero_machine; then
  exec "$real_fastfetch" --config "$config_dir/config.meromachine.jsonc" "$@"
else
  exec "$real_fastfetch" --config "$config_dir/config.jsonc" "$@"
fi
