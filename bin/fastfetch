#!/usr/bin/env bash
# Fastfetch dynamic wrapper - auto-scales logo and spec layout based on terminal width.
# Prevents logo distortion, eliminates startup lag, and provides 'fastfetch complete'.

set -euo pipefail

# 1. Fast binary resolution (avoiding recursive call to self)
REAL_FASTFETCH=""
for candidate in /usr/bin/fastfetch /usr/local/bin/fastfetch "$HOME/.local/bin/fastfetch"; do
    if [[ -x "$candidate" ]]; then
        cand_real="$(readlink -f "$candidate" 2>/dev/null || echo "$candidate")"
        self_real="$(readlink -f "$0" 2>/dev/null || echo "$0")"
        if [[ "$cand_real" != "$self_real" ]]; then
            REAL_FASTFETCH="$candidate"
            break
        fi
    fi
done

if [[ -z "$REAL_FASTFETCH" ]]; then
    while IFS= read -r candidate; do
        if [[ -x "$candidate" ]]; then
            cand_real="$(readlink -f "$candidate" 2>/dev/null || echo "$candidate")"
            self_real="$(readlink -f "$0" 2>/dev/null || echo "$0")"
            if [[ "$cand_real" != "$self_real" ]]; then
                REAL_FASTFETCH="$candidate"
                break
            fi
        fi
    done < <(type -ap fastfetch 2>/dev/null || true)
fi

if [[ -z "$REAL_FASTFETCH" ]]; then
    printf 'Error: fastfetch binary not found.\n' >&2
    exit 1
fi

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch"
[ -d "$CONFIG_DIR" ] || CONFIG_DIR="$HOME/mero_terminal/fastfetch"

# 2. Handle explicit subcommands
cmd="${1:-auto}"
case "$cmd" in
    complete|full|--full|-f)
        shift || true
        exec "$REAL_FASTFETCH" --config "$CONFIG_DIR/config.full.jsonc" "$@"
        ;;
    compact|--compact)
        shift || true
        exec "$REAL_FASTFETCH" --config "$CONFIG_DIR/config.compact.jsonc" "$@"
        ;;
    tiny|mobile|--tiny|-t)
        shift || true
        exec "$REAL_FASTFETCH" --config "$CONFIG_DIR/config.tiny.jsonc" "$@"
        ;;
    -c|--config|-h|--help|-v|--version|--list-*)
        # Passthrough raw fastfetch flags untouched
        exec "$REAL_FASTFETCH" "$@"
        ;;
esac

# 3. Fast width detection (reads $COLUMNS directly, fallback to tput)
cols="${COLUMNS:-}"
if [[ -z "$cols" ]] || ! [[ "$cols" =~ ^[0-9]+$ ]] || [[ "$cols" -le 0 ]]; then
    cols="$(tput cols 2>/dev/null || true)"
fi
if [[ -z "$cols" ]] || ! [[ "$cols" =~ ^[0-9]+$ ]] || [[ "$cols" -le 0 ]]; then
    cols=80
fi

# 4. Auto-Responsive Selection:
# - < 62 cols (Mobile phone portrait / ultra-narrow): Top logo layout, ~35 cols max.
# - 62..104 cols (Mobile landscape / Split panes / 80-col terms): Small side logo, ~60 cols max.
# - >= 105 cols (Wide windows): Full ASCII logo with clean specs, ~82 cols max.
if [[ "$cols" -lt 62 ]]; then
    exec "$REAL_FASTFETCH" --config "$CONFIG_DIR/config.tiny.jsonc" "$@"
elif [[ "$cols" -lt 105 ]]; then
    exec "$REAL_FASTFETCH" --config "$CONFIG_DIR/config.compact.jsonc" "$@"
else
    if [[ "$HOSTNAME" == "mero-machine" ]] && [[ -f "$CONFIG_DIR/config.meromachine.jsonc" ]]; then
        exec "$REAL_FASTFETCH" --config "$CONFIG_DIR/config.meromachine.jsonc" "$@"
    else
        exec "$REAL_FASTFETCH" --config "$CONFIG_DIR/config.jsonc" "$@"
    fi
fi