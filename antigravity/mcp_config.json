{
  "mcpServers": {
    "serena": {
      "command": "mero-mcp-serena",
      "args": [
        "start-mcp-server",
        "--context",
        "ide",
        "--project",
        ".",
        "--enable-web-dashboard",
        "false",
        "--open-web-dashboard",
        "false"
      ],
      "env": {
        "SERENA_HOME": "/tmp/mero-serena"
      }
    },
    "morph": {
      "command": "mero-mcp-morph",
      "args": []
    }
  }
}
