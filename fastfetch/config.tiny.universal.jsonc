{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "general": { "thread": true, "processingTimeout": 250 },
  "logo": {
    "type": "small",
    "position": "top",
    "source": "auto",
    "padding": { "left": 0, "right": 0, "top": 0 }
  },
  "display": {
    "separator": ": ",
    "brightColor": true,
    "key": { "width": 7, "type": "string" }
  },
  "modules": [
    { "type": "os", "key": "OS", "format": "{name} {arch}" },
    { "type": "kernel", "key": "Kernel", "format": "{release}" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "shell", "key": "Shell" },
    { "type": "memory", "key": "Memory", "format": "{used} / {total}" },
    { "type": "disk", "key": "Disk", "folders": "/", "format": "{size-used} / {size-total}" }
  ]
}
