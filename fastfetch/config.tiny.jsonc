{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "position": "top",
    "padding": {
      "left": 0,
      "right": 0,
      "top": 0
    }
  },
  "display": {
    "separator": ": ",
    "brightColor": true,
    "key": {
      "width": 8,
      "type": "string"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS",
      "format": "{pretty-name} {arch}"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "memory",
      "key": "Memory",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "Disk"
    },
    "break",
    "colors"
  ]
}
